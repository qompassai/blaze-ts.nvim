{
  "name": "blaze-ts.nvim",
  "version": "0.1.1",
  "description": "A \ud83d\udd25 Tree-sitter parser for the Mojo language with WASM, Zig, and Neovim integration.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./bindings/node/index.d.ts",
      "require": "./bindings/node/index.js",
      "default": "./bindings/node/index.js"
    }
  },
  "main": "bindings/node/index.js",
  "types": "bindings/node/index.d.ts",
  "browser": {
    "./bindings/node/index.js": "./parser/mojo.wasm"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qompassai/blaze-ts.nvim"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://www.buymeacoffee.com/phaedrusflow"
    },
    {
      "type": "organization",
      "url": "https://opencollective.com/qompassai"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/qompassai"
    },
    {
      "type": "custom",
      "url": "https://patreon.com/qompassai"
    },
    {
      "type": "custom",
      "url": "https://liberapay.com/qompassai"
    }
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Matt A. Porter",
    "email": "map@qompass.ai",
    "url": "https://github.com/qompassai"
  },
  "keywords": [
    "tree-sitter",
    "mojo",
    "zig",
    "wasm",
    "nvim",
    "neovim",
    "syntax-highlighting",
    "parser"
  ],
  "files": [
    "src/grammar.js",
    "tree-sitter.json",
    "parser/mojo.wasm",
    "binding.gyp",
    "bindings/",
    "runtime/queries/",
    "lua/",
    "src/",
    "parser/",
    "README.md",
    "package.json"
  ],
  "tree-sitter": [
    {
      "scope": "source.mojo",
      "file-types": [
        "mojo",
        "\ud83d\udd25"
      ]
    }
  ],
  "scripts": {
    "build": "tree-sitter generate src/grammar.js && tree-sitter build",
    "build:wasm": "tree-sitter build --wasm",
    "test": "tree-sitter test",
    "install": "node-gyp-build"
  },
  "dependencies": {
    "node-addon-api": "^8.3.0",
    "node-gyp-build": "^4.6.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-treesitter": "^1.0.0",
    "tree-sitter-cli": "^0.26.0",
    "tree-sitter": "^0.25.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
